# 模型配置示例：复制为 .env 并填入自己的 Key
# 任选一家（stepfun / deepseek），hello_agents 会自动检测

# StepFun（默认）
MODEL_API_KEY=your_stepfun_api_key_here
MODEL_BASE_URL=https://api.stepfun.com/v1
MODEL_NAME=step-3.7-flash

# DeepSeek（可选，填了 DEEPSEEK_API_KEY 会被自动检测）
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenCode Go / 任意 OpenAI 兼容网关（示例：DeepSeek V4.1 Flash）
# MODEL_BASE_URL=https://opencode.ai/inference/go/openai/v1
# MODEL_NAME=deepseek-v4.1-flash
# MODEL_API_KEY=your_opencode_go_key_here
# LLM_SESSION_ID=任意稳定 UUID（OpenCode Go 需要 x-opencode-session 头）
# LLM_USER_AGENT=hello-agents/1.0
